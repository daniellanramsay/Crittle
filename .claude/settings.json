{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag)",
      "Bash(git tag -a *)",
      "Bash(git tag --list *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(node --test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git tag)",
      "PowerShell(git tag -a *)",
      "PowerShell(git tag --list *)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git tag -d *)",
      "Bash(git tag -f *)",
      "Bash(git tag -a -f *)",
      "Bash(git commit --amend *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git stash *)",
      "PowerShell(git branch *)",
      "PowerShell(git tag -d *)",
      "PowerShell(git tag -f *)",
      "PowerShell(git tag -a -f *)",
      "PowerShell(git commit --amend *)",
      "PowerShell(git rm *)",
      "PowerShell(rm *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(del *)",
      "PowerShell(rmdir *)"
    ]
  }
}
